---
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '~/styles/global.css';

import SiteNav from '~/components/SiteNav.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import { getDictionary, otherLocale, type Locale } from '~/lib/i18n';
import { CONTACT, SEO, SITE_URL, absoluteUrl, withBase } from '~/config/site';
import { PROFILE } from '~/data/profile';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Chemin brut de la page courante, sans base, ex. '/projets/time2drive/'. */
  path: string;
  /** Chemin brut de la même page dans l'autre langue. */
  altPath: string;
  /** Page d'accueil ? Change le comportement des ancres de navigation. */
  isHome?: boolean;
  /** Exclut la page des moteurs (page 404). */
  noindex?: boolean;
}

const { locale, title, description, path, altPath, isHome = false, noindex = false } = Astro.props;

const dict = getDictionary(locale);
const other = otherLocale(locale);

const canonical = absoluteUrl(path);
const ogImageUrl = absoluteUrl(`/${SEO.ogImage}`);

const alternates = [
  { hreflang: locale === 'fr' ? 'fr' : 'en', href: absoluteUrl(path) },
  { hreflang: other === 'fr' ? 'fr' : 'en', href: absoluteUrl(altPath) },
  { hreflang: 'x-default', href: absoluteUrl(locale === 'fr' ? path : altPath) },
];

/* Données structurées. Uniquement des faits vérifiables : aucune notation, aucun avis. */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: PROFILE.name,
  url: SITE_URL,
  jobTitle: locale === 'fr' ? 'Apprenti ingénieur méthodes' : 'Methods engineering apprentice',
  description,
  email: `mailto:${CONTACT.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Paris',
    addressCountry: 'FR',
  },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'ESILV' },
    { '@type': 'CollegeOrUniversity', name: 'Université Paris-Saclay' },
  ],
  worksFor: { '@type': 'Organization', name: 'Air France Industries' },
  knowsLanguage: ['fr', 'en', 'es'],
  sameAs: [CONTACT.linkedin, CONTACT.github],
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${PROFILE.name} — ${PROFILE.role[locale]}`,
  url: SITE_URL,
  inLanguage: dict.meta.localeTag,
  author: { '@type': 'Person', name: PROFILE.name },
};
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta name="author" content={PROFILE.name} />
    <meta name="theme-color" content={SEO.themeColor} />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PROFILE.name} />
    <meta property="og:locale" content={dict.meta.localeTag.replace('-', '_')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${PROFILE.name} — ${PROFILE.role[locale]}`} />

    <meta name="twitter:card" content={SEO.twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <script is:inline set:html={JSON.stringify(personSchema)} type="application/ld+json" />
    <script is:inline set:html={JSON.stringify(siteSchema)} type="application/ld+json" />

    {/* Retire la classe no-js avant le premier rendu pour éviter tout scintillement. */}
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{dict.nav.skipToContent}</a>

    <SiteNav locale={locale} isHome={isHome} altPath={altPath} />

    <main id="main">
      <slot />
    </main>

    <SiteFooter locale={locale} />

    <script>
      /* Révélation au défilement. Une seule observation, aucune dépendance.
         Si prefers-reduced-motion est actif, tout est affiché immédiatement. */
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const revealAll = () => targets.forEach((el) => el.classList.add('is-visible'));

      /* Filet de sécurité : rien ne doit rester masqué à l'impression
         ou si l'observateur ne se déclenche jamais. */
      window.addEventListener('beforeprint', revealAll);

      if (reduced || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
