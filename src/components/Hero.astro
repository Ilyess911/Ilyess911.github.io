---
import { PROFILE } from '~/data/profile';
import { EXPERIENCE } from '~/data/experience';
import { CONTACT } from '~/config/site';
import { ANCHORS, getDictionary, type Locale } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);

/* Bandeau d'affiliations : du texte, jamais de logos, jamais de défilement infini. */
const affiliations = [
  {
    org: 'Air France Industries',
    detail: locale === 'fr' ? 'Alternance depuis 2024' : 'Apprenticeship since 2024',
  },
  {
    org: 'ESILV',
    detail: locale === 'fr' ? 'Industrie 4.0 et Robotique' : 'Industry 4.0 and Robotics',
  },
  {
    org: 'Nexya Agency',
    detail:
      locale === 'fr' ? 'Studio produit, co-fondé en 2025' : 'Product studio, co-founded 2025',
  },
] as const;

/* Vérifie que le bandeau reste aligné sur les expériences réelles. */
const knownOrgs = new Set(EXPERIENCE.map((e) => e.org));
const affiliationsAreConsistent = affiliations.every(
  (a) => knownOrgs.has(a.org) || a.org === 'ESILV',
);
if (!affiliationsAreConsistent) {
  throw new Error('Hero: une affiliation ne correspond à aucune expérience déclarée.');
}
---

<section class="hero">
  <div class="wrap">
    <p class="hero__eyebrow meta">
      {PROFILE.name}<span class="hero__sep" aria-hidden="true">/</span>{CONTACT.location[locale]}
    </p>

    <h1 class="hero__headline">
      {
        PROFILE.headline[locale].map((line, i) => (
          <span class="hero__line" style={`--i:${i}`}>
            {line}
          </span>
        ))
      }
    </h1>

    <p class="hero__subline">{PROFILE.subline[locale]}</p>

    <div class="hero__actions">
      <a class="btn btn--primary" href={`#${ANCHORS.selection}`}>
        {dict.hero.primaryCta}
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn" href={CONTACT.github} rel="noopener noreferrer" target="_blank">
        {dict.hero.secondaryCta}
        <span class="btn__arrow" aria-hidden="true">↗</span>
      </a>
      <a class="btn" href={`#${ANCHORS.contact}`}>{dict.hero.tertiaryCta}</a>
    </div>

    <p class="hero__availability">
      <span class="hero__dot" aria-hidden="true"></span>
      <span class="visually-hidden">{dict.hero.availabilityLabel} : </span>
      {PROFILE.availability[locale]}
    </p>
  </div>

  <div class="wrap">
    <ul class="hero__affiliations">
      {
        affiliations.map((a) => (
          <li class="hero__affiliation">
            <span class="hero__affiliation-org">{a.org}</span>
            <span class="hero__affiliation-detail meta">{a.detail}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3rem, 9vh, 6rem);
    padding-bottom: clamp(2rem, 5vh, 3.5rem);
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .hero__sep {
    color: var(--rule-strong);
  }

  .hero__headline {
    display: flex;
    flex-direction: column;
    font-size: var(--step-display);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.02;
    max-width: 18ch;
  }

  .hero__line {
    display: block;
    animation: hero-in 700ms var(--ease) backwards;
    animation-delay: calc(var(--i) * 90ms + 60ms);
  }

  /* La dernière ligne porte l'unique accent de couleur de la page d'accueil. */
  .hero__line:last-child {
    color: var(--accent);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(0.4em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__subline {
    max-width: 56ch;
    margin-top: clamp(1.5rem, 3.5vw, 2.25rem);
    font-size: var(--step-1);
    color: var(--ink-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .hero__availability {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .hero__dot {
    width: 0.4rem;
    height: 0.4rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--accent);
  }

  .hero__affiliations {
    display: grid;
    gap: 0;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--rule);
  }

  .hero__affiliation {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }

  .hero__affiliation-org {
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .hero__affiliation-detail {
    text-transform: none;
    letter-spacing: 0.01em;
  }

  @media (min-width: 46rem) {
    .hero__affiliations {
      grid-template-columns: repeat(3, 1fr);
      border-bottom: 1px solid var(--rule);
    }

    .hero__affiliation {
      border-bottom: 0;
      padding-inline-end: var(--space-5);
    }

    .hero__affiliation + .hero__affiliation {
      padding-inline-start: var(--space-5);
      border-inline-start: 1px solid var(--rule);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__line {
      animation: none;
    }
  }
</style>
