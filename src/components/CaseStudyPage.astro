---
import { Image } from 'astro:assets';

import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';

import { CONTACT } from '~/config/site';
import type { Project } from '~/data/types';
import { CASE_STUDY_PROJECTS } from '~/data/projects';
import { getProjectImage } from '~/lib/images';
import {
  ANCHORS,
  caseStudyPath,
  getDictionary,
  homePath,
  otherLocale,
  rawCaseStudyPath,
  type Locale,
} from '~/lib/i18n';
import { codeLabel, projectTitle, stageLabel } from '~/lib/project';

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const dict = getDictionary(locale);
const study = project.caseStudy;

if (!study) {
  throw new Error(`CaseStudyPage: le projet « ${project.slug} » n'a pas d'étude de cas.`);
}

const title = `${projectTitle(project, locale)} — ${dict.meta.title}`;
const description = `${project.tagline[locale]} ${project.positioning[locale]}`.slice(0, 300);

const currentIndex = CASE_STUDY_PROJECTS.findIndex((p) => p.slug === project.slug);
const next = CASE_STUDY_PROJECTS[(currentIndex + 1) % CASE_STUDY_PROJECTS.length];

/* Résout les visuels. Une clé absente du registre est une erreur de build,
   jamais une image cassée en production. */
const images = study.images.map((image) => {
  const asset = getProjectImage(image.key);
  if (!asset) {
    throw new Error(
      `CaseStudyPage: visuel « ${image.key} » absent de src/lib/images.ts (projet ${project.slug}).`,
    );
  }
  return { image, asset };
});
---

<Base
  locale={locale}
  title={title}
  description={description}
  path={rawCaseStudyPath(locale, project.slug)}
  altPath={rawCaseStudyPath(otherLocale(locale), project.slug)}
>
  <article class="case">
    <header class="case__header">
      <div class="wrap">
        <a class="case__back" href={`${homePath(locale)}#${ANCHORS.selection}`}>
          <span aria-hidden="true">←</span>
          {dict.caseStudy.backToSelection}
        </a>

        <p class="eyebrow eyebrow--accent case__kicker">
          <span class="num">{project.year}</span>
          <span class="case__kicker-sep" aria-hidden="true">/</span>
          <span>{stageLabel(project, locale)}</span>
        </p>
        <h1 class="case__title title-xl">{projectTitle(project, locale)}</h1>
        <div class="case__head">
          <div>
            <p class="case__tagline">{project.tagline[locale]}</p>
            <p class="case__positioning">{project.positioning[locale]}</p>
          </div>

          <dl class="case__facts card">
            <div class="case__fact">
              <dt class="eyebrow">{dict.caseStudy.role}</dt>
              <dd>{project.roleLabel[locale]}</dd>
            </div>
            <div class="case__fact">
              <dt class="eyebrow">{dict.caseStudy.stack}</dt>
              <dd class="case__stack">
                {project.stack.map((item) => <span class="tag">{item}</span>)}
              </dd>
            </div>
            <div class="case__fact">
              <dt class="eyebrow">{dict.caseStudy.links}</dt>
              <dd class="case__links">
                {
                  project.links.map((link) => (
                    <a class="link" href={link.href} rel="noopener noreferrer" target="_blank">
                      {link.label[locale]} <span aria-hidden="true">↗</span>
                    </a>
                  ))
                }
                <span
                  class:list={[
                    'case__code',
                    project.codeVisibility === 'public' && 'case__code--public',
                  ]}
                >
                  {codeLabel(project, locale)}
                </span>
                {
                  project.codeVisibility === 'private' && (
                    <span class="case__code-note">{dict.code.privateNote}</span>
                  )
                }
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </header>

    <Section rule labelledBy="cs-problem">
      <div class="case__split case__split--intro">
        <h2 id="cs-problem" class="case__h title-lg">{dict.caseStudy.problem}</h2>
        <p class="case__prose">{study.problem[locale]}</p>
      </div>

      <div class="case__pair">
        <div>
          <h3 class="case__sub eyebrow">{dict.caseStudy.audience}</h3>
          <p class="case__prose case__prose--small">{study.audience[locale]}</p>
        </div>
        <div>
          <h3 class="case__sub eyebrow">{dict.caseStudy.value}</h3>
          <p class="case__prose case__prose--small">{study.valueProposition[locale]}</p>
        </div>
      </div>
    </Section>

    <Section rule labelledBy="cs-product" sunk>
      <div class="case__split case__split--intro">
        <h2 id="cs-product" class="case__h title-lg">{dict.caseStudy.product}</h2>
        <p class="case__prose">{study.product[locale]}</p>
      </div>

      {
        images.length > 0 ? (
          <div class="case__shots">
            {images.map(({ image, asset }, i) => (
              <figure class="shot frame" data-reveal-plate>
                <figcaption class="frame__bar">
                  <span class="frame__dots" aria-hidden="true">
                    <span />
                    <span />
                    <span />
                  </span>
                  <span class="frame__label">
                    {project.slug} — {image.caption ? image.caption[locale] : image.alt[locale]}
                  </span>
                </figcaption>
                <span class="frame__body">
                  <Image
                    src={asset}
                    alt={image.alt[locale]}
                    widths={[420, 640, 860, 1200, 1600, 2000]}
                    sizes="(min-width: 76rem) 62rem, (min-width: 60rem) calc(100vw - 18rem), calc(100vw - 2.5rem)"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'auto'}
                    decoding="async"
                    quality={80}
                  />
                </span>
              </figure>
            ))}
          </div>
        ) : (
          <p class="case__pending">{dict.caseStudy.imagesPending}</p>
        )
      }
    </Section>

    <Section rule labelledBy="cs-role">
      <div class:list={['case__split', 'case__split--role', !study.collaboration && 'is-bare']}>
        <div class="case__role-side">
          <h2 id="cs-role" class="case__h title-lg">{dict.caseStudy.role}</h2>

          {
            study.collaboration && (
              <div class="case__collab">
                <h3 class="case__sub eyebrow">{dict.caseStudy.collaboration}</h3>
                <p class="case__prose case__prose--small">{study.collaboration[locale]}</p>
              </div>
            )
          }
        </div>

        <ul class="case__role-list">
          {study.role.map((item) => <li>{item[locale]}</li>)}
        </ul>
      </div>
    </Section>

    <Section rule labelledBy="cs-decisions" sunk>
      <h2 id="cs-decisions" class="case__h title-lg">{dict.caseStudy.decisions}</h2>

      <ol class="decisions">
        {
          study.decisions.map((decision, i) => (
            <li class="decision card" data-reveal>
              <span class="decision__num eyebrow num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="decision__title">{decision.title[locale]}</h3>
                <p class="decision__body">{decision.body[locale]}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </Section>

    <Section rule labelledBy="cs-outcome">
      <h2 id="cs-outcome" class="case__h title-lg">{dict.caseStudy.outcome}</h2>

      <div class="case__split case__split--outcome">
        <p class="case__prose case__prose--outcome">{study.outcome[locale]}</p>

        <div>
          <h3 class="case__sub eyebrow">{dict.caseStudy.learnings}</h3>
          <ul class="case__list">
            {study.learnings.map((item) => <li>{item[locale]}</li>)}
          </ul>
        </div>
      </div>
    </Section>

    <Section rule labelledBy="cs-limits">
      <div class="case__split case__split--limits">
        <div>
          <h2 id="cs-limits" class="case__h title-lg">{dict.caseStudy.limits}</h2>
          <p class="case__limits-lede">{dict.caseStudy.limitsIntro}</p>
        </div>

        <ul class="case__list case__list--limits">
          {study.limits.map((item) => <li>{item[locale]}</li>)}
        </ul>
      </div>
    </Section>

    <nav class="case__next" aria-label={dict.caseStudy.nextProject}>
      <div class="wrap case__next-grid">
        <a class="case__next-link" href={caseStudyPath(locale, next?.slug ?? project.slug)}>
          <span class="eyebrow">{dict.caseStudy.nextProject}</span>
          <span class="case__next-name">
            {next ? projectTitle(next, locale) : projectTitle(project, locale)}
            <span aria-hidden="true">→</span>
          </span>
        </a>

        {
          /* Un recruteur convaincu par une étude de cas ne doit pas avoir à
            remonter jusqu'à la home pour trouver comment écrire. */
        }
        <a class="btn btn--primary case__reach" href={`mailto:${CONTACT.email}`}>
          <span>{dict.contact.cta}</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </nav>
  </article>
</Base>

<style>
  .case__header {
    padding-top: clamp(2.5rem, 7vh, 4.5rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .case__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--step--1);
    color: var(--ink-3);
    transition: color var(--dur-hover) var(--ease-out);
  }

  .case__back:hover {
    color: var(--accent);
  }

  .case__title {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    font-size: var(--step-5);
    line-height: 0.94;
    max-width: 14ch;
  }

  .case__tagline {
    max-width: 52ch;
    margin-top: var(--space-4);
    font-size: var(--step-1);
    color: var(--ink-2);
  }

  .case__positioning {
    max-width: 52ch;
    margin-top: var(--space-4);
    color: var(--ink-3);
  }

  .case__facts {
    display: grid;
    gap: 0;
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .case__fact {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  .case__fact dd {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink);
  }

  .case__links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
  }

  .case__code {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .case__code--public {
    color: var(--accent);
  }

  .case__code-note {
    flex-basis: 100%;
    font-size: var(--step--2);
    color: var(--ink-3);
  }

  .case__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--canvas-sunk);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    line-height: 1.4;
    color: var(--ink-3);
  }

  .case__prose {
    max-width: var(--measure);
    margin-top: var(--space-5);
    color: var(--ink-2);
  }

  /* « Où en est le projet » porte les faits commerciaux : c'est le passage
     qu'un recruteur avant-vente cherche. Il ne peut pas être composé comme
     une note de bas de page. */
  #cs-outcome ~ .case__prose,
  .case__prose--outcome {
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink);
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--accent-line);
    border-radius: var(--r-lg);
    background: var(--accent-soft);
    max-width: 68ch;
  }

  .case__prose--small {
    font-size: var(--step--1);
    margin-top: var(--space-3);
  }

  .case__pair {
    display: grid;
    gap: var(--space-6);
    margin-top: clamp(2rem, 5vw, 3rem);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .case__sub {
    color: var(--accent);
  }

  .case__sub--spaced {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }

  .case__role-list {
    max-width: var(--measure);
    margin-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .case__collab {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .case__role-list li {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .case__collab {
    max-width: var(--measure);
    padding: var(--space-5);
    border: 1px solid var(--line-strong);
    border-left: 2px solid var(--accent);
    border-radius: var(--r-md);
    background: var(--surface);
  }

  .case__list {
    max-width: var(--measure);
    margin-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .case__list li {
    position: relative;
    padding-left: var(--space-5);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
    color: var(--ink-2);
  }

  .case__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.7em;
    width: 0.75rem;
    height: 1px;
    background: var(--line-strong);
  }

  .case__list--limits li::before {
    background: var(--accent);
  }

  /* Absence de capture : une bande pleine largeur plutôt qu'un petit encadré
     posé dans un coin. L'honnêteté doit occuper la place qu'aurait prise
     l'image, pas se signaler comme un oubli. */
  .case__pending {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(2rem, 5vw, 3.5rem) var(--space-5);
    border: 1px dashed var(--line-strong);
    border-radius: var(--r-lg);
    background: var(--surface-2);
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-3);
    text-align: center;
  }

  .case__shots {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .shot img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--surface);
  }

  .shot__caption {
    margin-top: var(--space-3);
    font-size: var(--step--2);
    color: var(--ink-3);
  }

  .decisions {
    margin-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .decision {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: clamp(1.5rem, 3.5vw, 2.25rem);
    border-bottom: 1px solid var(--line);
  }

  .decision__num {
    color: var(--accent);
    padding-top: 0.2em;
  }

  .decision__title {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.018em;
  }

  .decision__body {
    max-width: var(--measure);
    margin-top: var(--space-3);
    color: var(--ink-2);
  }

  /* ── Compositions ─────────────────────────────────────────────────────
     Chaque section a une grille dont les deux colonnes ont une fonction
     distincte, jamais deux `1fr` posées côte à côte. Sans cela, tous les
     blocs faisaient 587 px dans un conteneur de 1072 et la moitié droite de
     la page restait vide sur cinq sections d'affilée. */

  .case__split {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .case__limits-lede {
    max-width: 34ch;
    margin-top: var(--space-4);
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-3);
  }

  @media (min-width: 62rem) {
    /* Entrée de section : le titre tient une colonne étroite, l'exposé
       occupe la large. Le titre devient un repère, pas une bannière. */
    .case__split--intro {
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
      align-items: start;
    }

    .case__split--intro .case__prose {
      max-width: none;
      margin-top: 0.4rem;
      columns: 2;
      column-gap: clamp(2rem, 4vw, 3.5rem);
    }

    /* Mon rôle : à gauche le titre et l'attribution, à droite la liste des
       responsabilités sur deux colonnes. La collaboration cesse d'être une
       note sous une liste : elle devient l'un des deux blocs de la section. */
    /* Sans bloc de collaboration, la colonne de gauche ne porte que le titre :
       elle se resserre pour ne pas creuser un vide sous lui. */
    .case__split--role.is-bare {
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    }

    .case__split--role {
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1fr);
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
      align-items: start;
    }

    .case__split--role .case__role-list {
      max-width: none;
      margin-top: 0;
      columns: 2;
      column-gap: clamp(2rem, 4vw, 3rem);
      border-top: 0;
    }

    .case__split--role .case__role-list li {
      break-inside: avoid;
      border-top: 1px solid var(--line);
      border-bottom: 0;
    }

    /* Résultats : l'encart de statut fait contrepoids aux enseignements. */
    .case__split--outcome {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
      column-gap: clamp(2.5rem, 5vw, 4rem);
      align-items: start;
      margin-top: var(--space-5);
    }

    .case__split--outcome .case__prose--outcome {
      max-width: none;
      margin-top: 0;
    }

    .case__split--outcome .case__list {
      max-width: none;
      margin-top: var(--space-4);
    }

    /* Limites : l'avertissement tient la colonne étroite, la liste s'étale
       sur deux colonnes au lieu de descendre sur quatre cent cinquante
       pixels de haut dans la moitié gauche. */
    .case__split--limits {
      grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr);
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
      align-items: start;
    }

    .case__split--limits .case__list {
      max-width: none;
      margin-top: 0;
      columns: 2;
      column-gap: clamp(2rem, 4vw, 3rem);
      border-top: 0;
    }

    .case__split--limits .case__list li {
      break-inside: avoid;
      border-top: 1px solid var(--line);
      border-bottom: 0;
    }

    /* En-tête : le récit à gauche, la fiche technique à droite. */
    .case__head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.78fr);
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
      align-items: start;
      margin-top: clamp(1.5rem, 3vw, 2rem);
    }

    .case__facts {
      margin-top: 0;
    }

    /* Décisions : deux colonnes de cartes. Empilées, quatre cartes pleine
       largeur faisaient huit cents pixels de haut pour quatre idées. */
    .decisions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1rem, 2vw, 1.5rem);
      align-items: start;
      border-top: 0;
    }

    /* Fin de page : le projet suivant à gauche, l'action à droite. */
    .case__next-grid {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
    }
  }

  .case__next {
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .case__next-link {
    display: grid;
    gap: var(--space-2);
  }

  .case__next-name {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--ink);
    transition: color var(--dur-hover) var(--ease-out);
  }

  .case__next-link:hover .case__next-name {
    color: var(--accent);
  }

  .case__next-name span {
    transition: transform var(--dur-hover) var(--ease-out);
  }

  .case__next-link:hover .case__next-name span {
    transform: translateX(4px);
  }

  @media (min-width: 46rem) {
    .case__fact {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: var(--space-5);
      align-items: baseline;
    }

    .case__pair {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 5vw, 4rem);
    }
  }
</style>
