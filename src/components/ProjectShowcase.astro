---
import { Image } from 'astro:assets';

import type { Project } from '~/data/types';
import { getProjectImage } from '~/lib/images';
import { caseStudyPath, type Locale } from '~/lib/i18n';
import { projectTitle } from '~/lib/project';

interface Props {
  locale: Locale;
  projects: readonly Project[];
}

const { locale, projects } = Astro.props;

/**
 * Preuve visuelle sur la page d'accueil : la première capture réelle de chaque
 * projet qui en possède une. Un projet sans capture n'apparaît simplement pas,
 * plutôt que d'être représenté par un visuel fabriqué.
 */
const items = projects.flatMap((project) => {
  const first = project.caseStudy?.images[0];
  if (!first) return [];
  const asset = getProjectImage(first.key);
  if (!asset) return [];
  return [{ project, image: first, asset }];
});
---

{
  items.length > 0 && (
    <ul class="showcase">
      {items.map(({ project, image, asset }) => (
        <li class="showcase__item" data-reveal>
          <a class="showcase__link" href={caseStudyPath(locale, project.slug)}>
            <span class="showcase__frame">
              <Image
                src={asset}
                alt={image.alt[locale]}
                widths={[480, 760, 1200]}
                sizes="(min-width: 62rem) 30rem, calc(100vw - 2.5rem)"
                loading="lazy"
                decoding="async"
                quality={78}
              />
            </span>
            <span class="showcase__caption">
              <span class="showcase__name">
                {projectTitle(project, locale)}
                <span class="showcase__arrow" aria-hidden="true">
                  →
                </span>
              </span>
              <span class="showcase__detail">{project.tagline[locale]}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .showcase {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.75rem);
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }

  .showcase__link {
    display: grid;
    gap: var(--space-4);
  }

  .showcase__frame {
    display: block;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-raised);
  }

  .showcase__frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 420ms var(--ease);
  }

  .showcase__link:hover .showcase__frame :global(img) {
    transform: scale(1.012);
  }

  .showcase__caption {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  .showcase__name {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: color var(--dur) var(--ease);
  }

  .showcase__link:hover .showcase__name {
    color: var(--accent);
  }

  .showcase__arrow {
    font-size: 0.85em;
    color: var(--rule-strong);
    transition:
      transform var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .showcase__link:hover .showcase__arrow {
    color: var(--accent);
    transform: translateX(3px);
  }

  .showcase__detail {
    font-size: var(--step--2);
    color: var(--ink-3);
  }

  @media (min-width: 62rem) {
    .showcase {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase__frame :global(img),
    .showcase__link:hover .showcase__frame :global(img) {
      transition: none;
      transform: none;
    }
  }
</style>
