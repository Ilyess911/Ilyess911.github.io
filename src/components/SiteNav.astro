---
import { ANCHORS, anchorHref, getDictionary, homePath, otherLocale, type Locale } from '~/lib/i18n';
import { withBase } from '~/config/site';
import { PROFILE } from '~/data/profile';

interface Props {
  locale: Locale;
  isHome: boolean;
  altPath: string;
}

const { locale, isHome, altPath } = Astro.props;
const dict = getDictionary(locale);
const other = otherLocale(locale);

/* L'ordre suit celui de la page, pas une hiérarchie d'importance. */
const links = [
  { href: anchorHref(locale, ANCHORS.selection, isHome), label: dict.nav.selection },
  { href: anchorHref(locale, ANCHORS.experience, isHome), label: dict.nav.experience },
];
---

<header class="site-nav">
  <nav class="wrap site-nav__inner" aria-label={dict.nav.menu}>
    <a class="site-nav__brand" href={homePath(locale)}>
      <span class="site-nav__name">{PROFILE.name}</span>
      <span class="site-nav__role eyebrow">{PROFILE.role[locale]}</span>
    </a>

    <ul class="site-nav__links">
      {
        links.map((link) => (
          <li>
            <a class="site-nav__link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a class="site-nav__cta" href={anchorHref(locale, ANCHORS.contact, isHome)}>
      {dict.nav.contactCta}
    </a>

    <a
      class="lang-switch"
      href={withBase(altPath)}
      hreflang={other}
      lang={other}
      aria-label={dict.nav.switchLanguage}
    >
      {dict.nav.switchLanguageShort}
    </a>
  </nav>
</header>

<style>
  /* Le contact quitte la liste des ancres pour devenir un bouton : c'est la
     seule action de la barre, elle ne doit pas se lire comme une rubrique. */
  .site-nav__cta {
    display: none;
    align-items: center;
    padding: 0.4375rem 0.8125rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow-xs);
    font-size: var(--step--1);
    font-weight: 550;
    color: var(--ink);
    transition:
      border-color var(--dur-hover) ease,
      background-color var(--dur-hover) ease,
      color var(--dur-hover) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .site-nav__cta:hover {
      color: var(--accent);
      border-color: var(--accent-line);
      background: var(--accent-soft);
    }
  }

  @media (min-width: 52rem) {
    .site-nav__cta {
      display: inline-flex;
    }
  }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--canvas);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-hover) var(--ease-out);
  }

  /* Le filet n'apparaît qu'une fois le premier écran quitté : en haut de page,
     la barre se fond dans le papier. */
  .site-nav[data-compact] {
    border-bottom-color: var(--line);
  }

  .site-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 4.5rem;
    transition: min-height var(--dur-hover) var(--ease-out);
  }

  .site-nav[data-compact] .site-nav__inner {
    min-height: 3.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav,
    .site-nav__inner {
      transition: none;
    }
  }

  .site-nav__brand {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    min-width: 0;
  }

  .site-nav__name {
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .site-nav__role {
    display: none;
    padding-left: var(--space-3);
    border-left: 1px solid var(--line);
    text-transform: none;
    letter-spacing: 0.01em;
  }

  .site-nav__links {
    display: none;
    gap: clamp(1rem, 2.4vw, 2rem);
    margin-inline: auto;
  }

  .site-nav__link {
    position: relative;
    display: inline-block;
    padding-block: 0.35rem;
    color: var(--ink-2);
    font-size: var(--step--1);
    transition: color var(--dur-hover) var(--ease-out);
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-hover) var(--ease-out);
  }

  .site-nav__link:hover {
    color: var(--ink);
  }

  .site-nav__link:hover::after {
    transform: scaleX(1);
  }

  .lang-switch {
    flex-shrink: 0;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    transition:
      color var(--dur-hover) var(--ease-out),
      border-color var(--dur-hover) var(--ease-out);
  }

  .lang-switch:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (min-width: 34rem) {
    .site-nav__role {
      display: inline-block;
    }
  }

  @media (min-width: 52rem) {
    .site-nav__links {
      display: flex;
    }

    /* Le rôle redevient superflu quand les liens de section sont visibles. */
    .site-nav__role {
      display: none;
    }
  }

  @media (min-width: 68rem) {
    .site-nav__role {
      display: inline-block;
    }
  }
</style>

<script>
  /* Compaction au défilement : la barre se resserre dès qu'on quitte le premier
     écran. Un seul attribut change, tout le reste est en CSS. */
  const nav = document.querySelector<HTMLElement>('.site-nav');
  if (nav) {
    const update = () => {
      if (window.scrollY > 24) nav.dataset.compact = '';
      else delete nav.dataset.compact;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
