---
import { PRINCIPLES } from '~/data/profile';
import { getDictionary, type Locale } from '~/lib/i18n';

interface Props {
  locale: Locale;
  headingId: string;
}

const { locale, headingId } = Astro.props;
const dict = getDictionary(locale);
---

<h2 id={headingId} class="section-title">{dict.approach.title}</h2>
<p class="section-intro">{dict.approach.intro}</p>

<ol class="principles">
  {
    PRINCIPLES.map((principle, i) => (
      <li class="principle" data-reveal>
        <span class="principle__num meta num" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <div>
          <h3 class="principle__title">{principle.title[locale]}</h3>
          <p class="principle__body">{principle.body[locale]}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .principles {
    display: grid;
    gap: 0;
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    border-top: 1px solid var(--rule);
  }

  .principle {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: clamp(1.5rem, 3.5vw, 2.25rem);
    border-bottom: 1px solid var(--rule);
  }

  .principle__num {
    color: var(--accent);
    padding-top: 0.2em;
  }

  .principle__title {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.018em;
  }

  .principle__body {
    max-width: 58ch;
    margin-top: var(--space-3);
    color: var(--ink-2);
  }

  @media (min-width: 52rem) {
    .principles {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(2rem, 5vw, 4rem);
    }

    /* Filet supérieur uniquement sur la première rangée, pour garder la grille propre. */
    .principle:nth-child(-n + 2) {
      border-top: 0;
    }
  }
</style>
