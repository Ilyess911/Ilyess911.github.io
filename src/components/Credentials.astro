---
import { EDUCATION, EXPERIENCE } from '~/data/experience';
import { getDictionary, type Locale } from '~/lib/i18n';

/**
 * Le profil en une lecture.
 *
 * Un jury ou un recruteur lit d'abord une trajectoire, pas une stack. Cinq
 * cases, chacune un fait déjà prouvé ailleurs sur le site, rangées par
 * registre : ingénierie, entrepreneuriat, vente, leadership, international.
 * Le chiffre ouvre la case, la phrase le justifie.
 *
 * Grille : la première case en occupe deux, soit six cellules pour cinq
 * cases. Le compte tombe juste sur deux comme sur trois colonnes.
 *
 * Le bandeau des terrains reprend le motif marquee de Magic UI, réécrit en
 * CSS : le site n'expédie aucun JavaScript. Le nom des organisations est du
 * texte, jamais un logo, faute de droit d'usage des marques.
 */

interface Props {
  locale: Locale;
  headingId: string;
}

const { locale, headingId } = Astro.props;
const dict = getDictionary(locale);
const { cells } = dict.credentials;

const grounds = [
  ...EXPERIENCE.map((item) => item.org),
  ...EDUCATION.map((item) => item.org),
  'Café IA · Syntec-Ingénierie',
];
---

<section class="creds" aria-labelledby={headingId}>
  <div class="wrap">
    <header class="creds__open" data-reveal>
      <p class="eyebrow eyebrow--accent">{dict.credentials.label}</p>
      <h2 id={headingId} class="creds__title title-lg">{dict.credentials.title}</h2>
    </header>

    <ul class="creds__grid">
      {
        cells.map((cell, i) => (
          <li
            class:list={['creds__cell', 'card', 'card--lift', i === 0 && 'creds__cell--lead']}
            data-reveal
          >
            <p class="creds__kicker eyebrow">{cell.kicker}</p>
            <p class="creds__figure num">{cell.figure}</p>
            <p class="creds__body">{cell.body}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="marquee" data-reveal>
    <p class="visually-hidden">{dict.credentials.marqueeLabel}</p>
    <div class="marquee__track">
      <ul class="marquee__list">
        {grounds.map((name) => <li class="marquee__item">{name}</li>)}
      </ul>
      <ul class="marquee__list" aria-hidden="true">
        {grounds.map((name) => <li class="marquee__item">{name}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .creds {
    padding-top: clamp(3rem, 7vw, 5rem);
    background: var(--canvas);
    border-bottom: 1px solid var(--line);
  }

  .creds__open {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .creds__title {
    margin-top: var(--space-4);
    max-width: 18ch;
  }

  .creds__grid {
    display: grid;
    gap: var(--space-3);
  }

  .creds__cell {
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .creds__kicker {
    color: var(--ink-3);
  }

  /* Le chiffre est le titre de la case : grand, serré, à l'encre. Une seule
     teinte d'accent sur toute la grille, celle de la case principale. */
  .creds__figure {
    margin-top: var(--space-4);
    font-size: var(--step-4);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .creds__body {
    margin-top: var(--space-3);
    max-width: 38ch;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .creds__cell--lead {
    background: linear-gradient(160deg, var(--accent-soft), var(--surface) 70%);
    border-color: var(--accent-line);
  }

  .creds__cell--lead .creds__kicker,
  .creds__cell--lead .creds__figure {
    color: var(--accent);
  }

  .creds__cell--lead .creds__figure {
    font-size: var(--step-5);
  }

  @media (min-width: 44rem) {
    .creds__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .creds__cell--lead {
      grid-column: span 2;
    }
  }

  @media (min-width: 68rem) {
    .creds__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* La case principale ouvre la grille sur deux colonnes : le texte se
       pose en bas, face au chiffre, au lieu de laisser un vide sous lui. */
    .creds__cell--lead {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: var(--space-6);
    }

    .creds__cell--lead .creds__kicker {
      grid-column: 1 / -1;
    }

    .creds__cell--lead .creds__figure,
    .creds__cell--lead .creds__body {
      align-self: end;
    }

    .creds__cell--lead .creds__body {
      margin-top: 0;
    }
  }

  /* ── Bandeau des terrains ─────────────────────────────────────────── */

  .marquee {
    position: relative;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-block: var(--space-5);
    overflow: hidden;
    border-top: 1px solid var(--line);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 48s linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__list {
    display: flex;
    flex: none;
  }

  /* Le séparateur appartient à chaque nom, si bien que la boucle se referme
     sans couture : la seconde copie commence exactement où la première finit. */
  .marquee__item {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--ink-3);
  }

  .marquee__item::after {
    content: '';
    width: 0.3125rem;
    height: 0.3125rem;
    margin-inline: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: 50%;
    background: var(--line-strong);
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Sans mouvement : une seule copie, posée et centrée, qui passe à la ligne. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .marquee__track {
      width: auto;
      animation: none;
    }

    .marquee__list {
      flex: 1;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: var(--space-2);
    }

    .marquee__list[aria-hidden='true'] {
      display: none;
    }
  }
</style>
