---
import { LANGUAGES, SKILLS } from '~/data/profile';
import { getDictionary, type Locale } from '~/lib/i18n';

interface Props {
  locale: Locale;
  headingId: string;
}

const { locale, headingId } = Astro.props;
const dict = getDictionary(locale);
---

<h2 id={headingId} class="section-title">{dict.toolbox.title}</h2>
<p class="section-intro">{dict.toolbox.intro}</p>

<dl class="tools">
  {
    SKILLS.map((group) => (
      <div class="tools__group" data-reveal>
        <dt class="tools__label meta">{group.label[locale]}</dt>
        <dd class="tools__items">
          {group.items.map((item, i) => (
            <>
              {i > 0 && (
                <span class="tools__sep" aria-hidden="true">
                  ·
                </span>
              )}
              <span>{item}</span>
            </>
          ))}
        </dd>
      </div>
    ))
  }

  <div class="tools__group" data-reveal>
    <dt class="tools__label meta">{dict.toolbox.languagesTitle}</dt>
    <dd class="tools__items">
      {
        LANGUAGES.map((lang, i) => (
          <>
            {i > 0 && (
              <span class="tools__sep" aria-hidden="true">
                ·
              </span>
            )}
            <span>
              {lang.label[locale]} <span class="tools__level">({lang.level[locale]})</span>
            </span>
          </>
        ))
      }
    </dd>
  </div>
</dl>

<style>
  .tools {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    border-top: 1px solid var(--rule);
  }

  .tools__group {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--rule);
  }

  .tools__label {
    padding-top: 0.2em;
  }

  .tools__items {
    margin: 0;
    color: var(--ink);
    font-size: var(--step--1);
    line-height: 1.9;
  }

  .tools__sep {
    color: var(--rule-strong);
    margin-inline: 0.5em;
  }

  .tools__level {
    color: var(--ink-3);
  }

  @media (min-width: 46rem) {
    .tools__group {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
</style>
