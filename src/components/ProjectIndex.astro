---
import type { Project } from '~/data/types';
import { getDictionary, type Locale } from '~/lib/i18n';
import { codeLabel, primaryHref, projectTitle, stageLabel } from '~/lib/project';

interface Props {
  locale: Locale;
  projects: readonly Project[];
  /** Décalage de numérotation quand l'index est scindé en deux listes. */
  startIndex?: number;
}

const { locale, projects, startIndex = 1 } = Astro.props;
const dict = getDictionary(locale);

const rows = projects.map((project, i) => ({
  project,
  index: String(startIndex + i).padStart(2, '0'),
  target: primaryHref(project, locale),
}));
---

<ul class="index">
  {
    rows.map(({ project, index, target }) => (
      <li class:list={['index__row', target && 'index__row--linked']} data-reveal>
        <span class="index__num meta num" aria-hidden="true">
          {index}
        </span>

        <div class="index__main">
          <h3 class="index__name">
            {target ? (
              <a
                class="index__link"
                href={target.href}
                rel={target.external ? 'noopener noreferrer' : undefined}
                target={target.external ? '_blank' : undefined}
              >
                {projectTitle(project, locale)}
                <span class="index__arrow" aria-hidden="true">
                  {target.external ? '↗' : '→'}
                </span>
              </a>
            ) : (
              projectTitle(project, locale)
            )}
          </h3>
          <p class="index__tagline">{project.tagline[locale]}</p>
        </div>

        <p class="index__role">{project.roleLabel[locale]}</p>

        <dl class="index__meta">
          <div>
            <dt class="visually-hidden">{dict.selection.columns.year}</dt>
            <dd class="num">{project.year}</dd>
          </div>
          <div>
            <dt class="visually-hidden">{dict.selection.columns.status}</dt>
            <dd>{stageLabel(project, locale)}</dd>
          </div>
          <div>
            <dt class="visually-hidden">Code</dt>
            <dd class:list={[project.codeVisibility === 'public' && 'index__code--public']}>
              {codeLabel(project, locale)}
            </dd>
          </div>
        </dl>
      </li>
    ))
  }
</ul>

<style>
  .index {
    border-top: 1px solid var(--rule);
  }

  .index__row {
    position: relative;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    padding-block: clamp(1.35rem, 3vw, 1.9rem);
    padding-inline: 0;
    border-bottom: 1px solid var(--rule);
    transition:
      background-color var(--dur) var(--ease),
      padding-inline var(--dur) var(--ease);
  }

  .index__row--linked:hover {
    background: var(--paper-sunk);
    padding-inline: var(--space-4);
    margin-inline: calc(-1 * var(--space-4));
  }

  .index__num {
    color: var(--rule-strong);
    padding-top: 0.28em;
  }

  .index__main {
    min-width: 0;
  }

  .index__name {
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .index__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    transition: color var(--dur) var(--ease);
  }

  /* La ligne entière devient cliquable, sans imbriquer de liens. */
  .index__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .index__row--linked:hover .index__link {
    color: var(--accent);
  }

  .index__arrow {
    font-size: 0.7em;
    color: var(--rule-strong);
    transition:
      transform var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .index__row--linked:hover .index__arrow {
    color: var(--accent);
    transform: translateX(3px);
  }

  .index__tagline {
    max-width: 46ch;
    margin-top: var(--space-2);
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .index__role {
    grid-column: 2;
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  .index__meta {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    color: var(--ink-3);
    text-transform: uppercase;
  }

  .index__meta dd {
    margin: 0;
  }

  .index__code--public {
    color: var(--accent);
  }

  @media (min-width: 62rem) {
    .index__row {
      grid-template-columns: 2.25rem minmax(0, 1.55fr) minmax(0, 1fr) minmax(0, 0.85fr);
      align-items: start;
      gap: var(--space-5);
    }

    .index__role {
      grid-column: 3;
      padding-top: 0.4em;
    }

    .index__meta {
      grid-column: 4;
      flex-direction: column;
      gap: var(--space-2);
      margin-top: 0.4em;
      text-align: right;
      align-items: flex-end;
    }
  }
</style>
