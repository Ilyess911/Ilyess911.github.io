---
import { PROJECTS } from '~/data/projects';
import { getDictionary, type Locale } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);

/* Les produits construits sous le studio, dans l'ordre de la sélection. */
const studioProjects = PROJECTS.filter((p) => p.studio === 'nexya');

/* Le texte du studio annonce trois produits : on vérifie que le contenu suit. */
if (studioProjects.length !== 3) {
  throw new Error(
    `Studio: ${studioProjects.length} produit(s) rattaché(s) à Nexya, mais la description en annonce trois. ` +
      'Mettre à jour `studio.description` dans les traductions ou le champ `studio` des projets.',
  );
}
---

<aside class="studio" aria-label={dict.studio.name}>
  <div class="studio__intro">
    <p class="studio__label meta">{dict.studio.label}</p>
    <h3 class="studio__name">{dict.studio.name}</h3>
    <p class="studio__description">{dict.studio.description}</p>
  </div>

  <ul class="studio__tree">
    {
      studioProjects.map((project) => (
        <li class="studio__node">
          <span class="studio__node-name">{project.name}</span>
          {project.category && <span class="studio__node-detail">{project.category[locale]}</span>}
        </li>
      ))
    }
    <li class="studio__node studio__node--future">
      <span class="studio__node-name">{dict.studio.futureLabel}</span>
    </li>
  </ul>
</aside>

<style>
  .studio {
    display: grid;
    gap: var(--space-6);
    padding-block: clamp(1.75rem, 4vw, 2.5rem);
    /* Pas de filet bas : celui de l'index des projets ferme le bloc juste après,
       deux filets rapprochés se liraient comme une erreur. */
    border-top: 1px solid var(--rule);
  }

  .studio__intro {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .studio__name {
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .studio__description {
    max-width: 46ch;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  /* Arborescence typographique : un filet vertical et des ergots, construits en CSS.
     Aucun caractère de dessin, aucune esthétique terminal. */
  .studio__tree {
    align-self: start;
    margin-left: 0.25rem;
    border-left: 1px solid var(--rule-strong);
  }

  .studio__node {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    padding-left: var(--space-5);
    padding-block: var(--space-3);
  }

  .studio__node::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.55em;
    width: 0.85rem;
    height: 1px;
    background: var(--rule-strong);
  }

  .studio__node-name {
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .studio__node-detail {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .studio__node--future .studio__node-name {
    font-weight: 400;
    color: var(--ink-3);
    font-style: italic;
  }

  @media (min-width: 52rem) {
    .studio {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      column-gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }
  }
</style>
