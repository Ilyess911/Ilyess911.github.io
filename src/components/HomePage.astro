---
import Base from '~/layouts/Base.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import Intro from '~/components/Intro.astro';
import FieldProof from '~/components/FieldProof.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import Experience from '~/components/Experience.astro';
import Contact from '~/components/Contact.astro';

import { FEATURED_PROJECTS, VISIBLE_PROJECTS } from '~/data/projects';
import { CONTACT, GITHUB_USERNAME, SITE_REPO } from '~/config/site';
import { ANCHORS, getDictionary, otherLocale, rawHomePath, type Locale } from '~/lib/i18n';
import { projectTitle } from '~/lib/project';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);

/**
 * Mise en page de chaque projet. Le choix est explicite : ajouter un projet
 * doit obliger à se demander quelle forme lui donner, pas à en hériter une.
 */
const LAYOUTS: Record<string, 'wide' | 'split' | 'quiet'> = {
  time2drive: 'wide',
  'resum-eye': 'quiet',
  atlas: 'split',
};

/** Coda : ce qui existe sans mériter une carte. Une ligne, pas une section. */
const coda = VISIBLE_PROJECTS.filter((p) => !p.featured).map((p) => ({
  name: projectTitle(p, locale),
  href: p.links.find((l) => l.kind === 'code')?.href,
}));
---

<Base
  locale={locale}
  title={dict.meta.title}
  description={dict.meta.description}
  path={rawHomePath(locale)}
  altPath={rawHomePath(otherLocale(locale))}
  isHome
>
  <Hero locale={locale} />

  <FieldProof locale={locale} headingId="proof-title" />

  <Section labelledBy="intro-title">
    <Intro locale={locale} headingId="intro-title" />
  </Section>

  <section id={ANCHORS.selection} class="work" aria-labelledby="work-title">
    <div class="wrap">
      <header class="work__open" data-reveal>
        <p class="eyebrow eyebrow--accent">{dict.hero.projectsLabel}</p>
        <h2 id="work-title" class="work__title title-lg">{dict.selection.title}</h2>
        <p class="work__note">{dict.studio.description}</p>
      </header>

      <div class="work__list">
        {
          FEATURED_PROJECTS.map((project) => (
            <ProjectCard
              locale={locale}
              project={project}
              layout={LAYOUTS[project.slug] ?? 'split'}
            />
          ))
        }
      </div>

      <div class="exit" data-reveal>
        <p class="exit__title">{dict.selection.exitTitle}</p>
        <a class="btn btn--primary" href={`#${ANCHORS.contact}`}>
          <span>{dict.selection.exitCta}</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <p class="coda" data-reveal>
        <span class="eyebrow">{dict.workshop.title}</span>
        {
          coda.map((item) =>
            item.href ? (
              <a class="coda__link" href={item.href} rel="noopener noreferrer" target="_blank">
                {item.name} <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="coda__link">{item.name}</span>
            ),
          )
        }
        <a
          class="coda__link"
          href={`https://github.com/${GITHUB_USERNAME}/${SITE_REPO}`}
          rel="noopener noreferrer"
          target="_blank">{dict.workshop.thisSite} <span aria-hidden="true">↗</span></a
        >
        <a class="coda__link" href={CONTACT.github} rel="noopener noreferrer" target="_blank"
          >{dict.workshop.githubCta} <span aria-hidden="true">↗</span></a
        >
      </p>
    </div>
  </section>

  <Section id={ANCHORS.experience} labelledBy="experience-title">
    <header class="track__open" data-reveal>
      <p class="eyebrow eyebrow--accent">{dict.nav.experience}</p>
      <p class="track__title title-lg">{dict.experience.title}</p>
    </header>
    <Experience locale={locale} headingId="experience-title" />
  </Section>

  <Section id={ANCHORS.contact} labelledBy="contact-title" sunk>
    <Contact locale={locale} headingId="contact-title" />
  </Section>
</Base>

<style>
  /* La section projets est le cœur de la page : elle change de fond pour que
     l'œil sache immédiatement qu'il entre ailleurs. */
  .work {
    padding-block: clamp(4.5rem, 10vw, 8rem);
    background: var(--canvas-sunk);
    border-block: 1px solid var(--line);
  }

  .work__open,
  .track__open {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .work__title,
  .track__title {
    margin-top: var(--space-4);
    max-width: 16ch;
    color: var(--ink);
  }

  .work__note {
    max-width: 46ch;
    margin-top: var(--space-4);
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--ink-3);
  }

  /* Ouverture de section : le titre laissait une bande vide de six cents
     pixels à sa droite. La note vient l'occuper, alignée sur sa dernière
     ligne plutôt que posée dessous. */
  @media (min-width: 62rem) {
    .work__open {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(3rem, 6vw, 5rem);
      align-items: end;
    }

    .work__open > .eyebrow {
      grid-column: 1;
    }

    .work__title {
      grid-column: 1;
    }

    .work__note {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: end;
      margin-top: 0;
      padding-bottom: 0.35rem;
    }

    .track__title {
      max-width: 20ch;
    }
  }

  .work__list {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  /* Sortie de section : une ligne et un bouton. Le contact arrivait à
     6 400 px du haut, c'est-à-dire après le moment où l'on est convaincu. */
  .exit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .exit__title {
    flex: 1 1 18rem;
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  /* Coda : tout ce qui existe sans mériter une carte, sur une seule ligne. */
  .coda {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: clamp(1.5rem, 3vw, 2rem);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .coda__link {
    padding: 0.3125rem 0.625rem;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
    font-size: var(--step--1);
    color: var(--ink-3);
    transition:
      color var(--dur-hover) ease,
      border-color var(--dur-hover) ease,
      background-color var(--dur-hover) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    a.coda__link:hover {
      color: var(--accent);
      border-color: var(--accent-line);
      background: var(--accent-soft);
    }
  }
</style>
